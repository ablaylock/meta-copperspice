From 892cecb79fda3c68c1fb082a0c2a4bdcb7e0bf33 Mon Sep 17 00:00:00 2001
From: Allen Blaylock <alblay.lhs@gmail.com>
Date: Thu, 9 Jul 2026 10:19:53 -0600
Subject: [PATCH] cmake: do not export sysroot paths for private dependencies

The CopperSpice shared libraries declare several external dependencies
as PUBLIC, which bakes the absolute build-time paths of those
dependencies (the cross-compile sysroot) into the exported
CopperSpiceLibraryTargets.cmake usage requirements:

- CsCore links ${ZLIB_LIBRARIES} PUBLIC, but zlib is an implementation
  detail: no public CsCore header includes zlib.h.
- CsGui and CsOpenGL export ${OPENGL_INCLUDE_DIR} and
  ${OPENGL_LIBRARIES}. GL headers reached through public headers
  (qopengl.h) use standard <GL/...> includes found on the compiler's
  default search path, and applications calling GL entry points
  directly should locate OpenGL themselves.
- CsMultimedia exports ${GSTREAMER_INCLUDE_DIRS}, but no public
  QtMultimedia header includes GStreamer headers.

Change these to PRIVATE. The shared libraries still record the
dependencies in DT_NEEDED, so runtime linking is unchanged; only the
leaked absolute paths disappear from the exported CMake package.

Targets that consume these dependencies directly previously freeloaded
on the PUBLIC propagation and now need their own PRIVATE usage:

- zlib callers: CsGui (qzip.cpp, qpdf.cpp), CsNetwork
  (qhttp_networkreply.cpp, qspdyprotocolhandler.cpp), CsSvg
  (qsvgtinydocument.cpp) each get a PRIVATE ${ZLIB_LIBRARIES} link.
- GL callers: the CsGuiXcb_Glx platform plugin (glX*) and CsMultimedia
  (fixed-pipeline GL in widgets/qpaintervideosurface.cpp) each get a
  PRIVATE ${OPENGL_LIBRARIES} link.
- The GStreamer mediaservice plugins (CsMultimedia_gst_audiodecoder,
  _gst_camerabin, _gst_mediaplayer) request ${GSTREAMER_INCLUDE_DIR},
  a variable FindGStreamer.cmake never defines; they only compiled via
  CsMultimedia's PUBLIC include dirs. Use ${GSTREAMER_INCLUDE_DIRS}.

Upstream-Status: Pending
Signed-off-by: Allen Blaylock <alblay.lhs@gmail.com>
---
 src/core/CMakeLists.txt                                |  2 +-
 src/gui/CMakeLists.txt                                 | 10 +++++++++-
 src/multimedia/CMakeLists.txt                          |  4 +++-
 src/network/CMakeLists.txt                             |  7 +++++++
 src/opengl/CMakeLists.txt                              |  1 +
 .../multimedia/mediaservices/gstreamer/gstreamer.cmake |  6 +++---
 src/plugins/platforms/xcb/glx/xcb_glx.cmake            |  1 +
 src/svg/CMakeLists.txt                                 |  7 +++++++
 8 files changed, 32 insertions(+), 6 deletions(-)

diff --git a/src/core/CMakeLists.txt b/src/core/CMakeLists.txt
index 2e14caa..c4098c0 100644
--- a/src/core/CMakeLists.txt
+++ b/src/core/CMakeLists.txt
@@ -194,7 +194,7 @@ endif()
 
 if (ZLIB_FOUND)
    target_link_libraries(CsCore
-      PUBLIC
+      PRIVATE
       ${ZLIB_LIBRARIES}
    )
 
diff --git a/src/gui/CMakeLists.txt b/src/gui/CMakeLists.txt
index 2860dad..0b408f2 100644
--- a/src/gui/CMakeLists.txt
+++ b/src/gui/CMakeLists.txt
@@ -180,13 +180,14 @@ target_sources(CsGui
 )
 
 target_include_directories(CsGui
-   PUBLIC
+   PRIVATE
    ${OPENGL_INCLUDE_DIR}
 )
 
 target_link_libraries(CsGui
    PUBLIC
    CsCore
+   PRIVATE
    ${OPENGL_LIBRARIES}
 )
 
@@ -197,6 +198,13 @@ if (${JPEG_FOUND})
    )
 endif()
 
+if (ZLIB_FOUND)
+   target_link_libraries(CsGui
+      PRIVATE
+      ${ZLIB_LIBRARIES}
+   )
+endif()
+
 target_compile_options(CsGui
    PRIVATE
    $<$<COMPILE_LANGUAGE:CXX>:SHELL:${EXTRA_GUI_CXXFLAGS}>
diff --git a/src/multimedia/CMakeLists.txt b/src/multimedia/CMakeLists.txt
index 0ea80a4..7e58528 100644
--- a/src/multimedia/CMakeLists.txt
+++ b/src/multimedia/CMakeLists.txt
@@ -71,10 +71,12 @@ target_link_libraries(CsMultimedia
    CsGui
    CsNetwork
    CsOpenGL
+   PRIVATE
+   ${OPENGL_LIBRARIES}
 )
 
 target_include_directories(CsMultimedia
-   PUBLIC
+   PRIVATE
    ${GSTREAMER_INCLUDE_DIRS}
 )
 
diff --git a/src/network/CMakeLists.txt b/src/network/CMakeLists.txt
index ac176f7..5dce091 100644
--- a/src/network/CMakeLists.txt
+++ b/src/network/CMakeLists.txt
@@ -96,6 +96,13 @@ target_link_libraries(CsNetwork
    CsCore
 )
 
+if (ZLIB_FOUND)
+   target_link_libraries(CsNetwork
+      PRIVATE
+      ${ZLIB_LIBRARIES}
+   )
+endif()
+
 target_compile_options(CsNetwork
    PRIVATE
    $<$<COMPILE_LANGUAGE:CXX>:SHELL:${EXTRA_NETWORK_CXXFLAGS}>
diff --git a/src/opengl/CMakeLists.txt b/src/opengl/CMakeLists.txt
index 94bde19..bb8355e 100644
--- a/src/opengl/CMakeLists.txt
+++ b/src/opengl/CMakeLists.txt
@@ -130,6 +130,7 @@ target_link_libraries(CsOpenGL
    PUBLIC
    CsCore
    CsGui
+   PRIVATE
    ${OPENGL_LIBRARIES}
 )
 
diff --git a/src/plugins/multimedia/mediaservices/gstreamer/gstreamer.cmake b/src/plugins/multimedia/mediaservices/gstreamer/gstreamer.cmake
index 55d82f0..4159771 100644
--- a/src/plugins/multimedia/mediaservices/gstreamer/gstreamer.cmake
+++ b/src/plugins/multimedia/mediaservices/gstreamer/gstreamer.cmake
@@ -106,7 +106,7 @@ if(WITH_MULTIMEDIA AND GStreamer_FOUND)
    target_include_directories(
       CsMultimedia_gst_audiodecoder
       PRIVATE
-      ${GSTREAMER_INCLUDE_DIR}
+      ${GSTREAMER_INCLUDE_DIRS}
       ${GLIB2_INCLUDES}
    )
 
@@ -167,7 +167,7 @@ if(WITH_MULTIMEDIA AND GStreamer_FOUND)
    target_include_directories(
       CsMultimedia_gst_camerabin
       PRIVATE
-      ${GSTREAMER_INCLUDE_DIR}
+      ${GSTREAMER_INCLUDE_DIRS}
       ${GLIB2_INCLUDES}
    )
 
@@ -217,7 +217,7 @@ if(WITH_MULTIMEDIA AND GStreamer_FOUND)
    target_include_directories(
       CsMultimedia_gst_mediaplayer
       PRIVATE
-      ${GSTREAMER_INCLUDE_DIR}
+      ${GSTREAMER_INCLUDE_DIRS}
       ${GLIB2_INCLUDES}
    )
 
diff --git a/src/plugins/platforms/xcb/glx/xcb_glx.cmake b/src/plugins/platforms/xcb/glx/xcb_glx.cmake
index 46631e5..a029c4b 100644
--- a/src/plugins/platforms/xcb/glx/xcb_glx.cmake
+++ b/src/plugins/platforms/xcb/glx/xcb_glx.cmake
@@ -34,6 +34,7 @@ if(BUILD_PLATFORMS_XCB_PLUGIN AND XCB_GLX_LIB)
       ${XCB_LIB}
       ${XCB_GLX_LIB}
       ${X11_X11_LIB}
+      ${OPENGL_LIBRARIES}
    )
 
    target_include_directories(CsGuiXcb_Glx
diff --git a/src/svg/CMakeLists.txt b/src/svg/CMakeLists.txt
index 5785aa6..2b50358 100644
--- a/src/svg/CMakeLists.txt
+++ b/src/svg/CMakeLists.txt
@@ -91,6 +91,13 @@ target_link_libraries(CsSvg
    CsGui
 )
 
+if (ZLIB_FOUND)
+   target_link_libraries(CsSvg
+      PRIVATE
+      ${ZLIB_LIBRARIES}
+   )
+endif()
+
 target_compile_options(CsSvg
    PRIVATE
    $<$<COMPILE_LANGUAGE:CXX>:SHELL:${EXTRA_SVG_CXXFLAGS}>
