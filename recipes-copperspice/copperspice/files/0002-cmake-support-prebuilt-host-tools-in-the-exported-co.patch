From f413f97b5cf1fc853748334412079997af99bd53 Mon Sep 17 00:00:00 2001
From: Allen Blay <alblay.lhs@gmail.com>
Date: Thu, 9 Jul 2026 12:08:37 -0600
Subject: [PATCH] cmake: support prebuilt host tools in the exported config

Downstream projects process .ui/.qrc/.ts files through the
CopperSpice::uic/rcc/lrelease IMPORTED targets, which normally come
from CopperSpiceBinaryTargets.cmake and point into the CopperSpice
installation. When that installation was cross compiled the tools can
not run on the build machine, and BinaryTargets.cmake fatally validates
that each tool exists in the installation being consumed - which is
never the case in a cross sysroot that stages only libraries and
headers.

When CS_TOOL_* variables are set (the same variables the CopperSpice
build itself honors), skip CopperSpiceBinaryTargets.cmake entirely and
create the tool IMPORTED targets from the provided host tools instead.
Behavior is unchanged when they are not set.

A consumer referencing a tool target for which no CS_TOOL_* variable
was provided (e.g. CopperSpice::linguist) gets a missing-target error;
that is acceptable, since such a consumer could not have executed the
target-architecture tool anyway.

Upstream-Status: Pending [https://github.com/copperspice/copperspice]
---
 cmake/CopperSpiceConfig.cmake | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/cmake/CopperSpiceConfig.cmake b/cmake/CopperSpiceConfig.cmake
index 308f036..66c998f 100644
--- a/cmake/CopperSpiceConfig.cmake
+++ b/cmake/CopperSpiceConfig.cmake
@@ -36,7 +36,24 @@ get_filename_component(COPPERSPICE_PREFIX ${COPPERSPICE_CMAKE_DIR}/ ABSOLUTE)
 
 # library and binary dependencies (contains definitions for IMPORTED targets)
 include("${COPPERSPICE_CMAKE_DIR}/CopperSpiceLibraryTargets.cmake")
-include("${COPPERSPICE_CMAKE_DIR}/CopperSpiceBinaryTargets.cmake")
+if(CS_TOOL_UIC)
+   # cross compiling: prebuilt host tools are provided via CS_TOOL_*.
+   # Do not include CopperSpiceBinaryTargets.cmake at all - it validates
+   # that the target-architecture tools exist in this installation, which
+   # is not the case in cross sysroots. Create the tool targets from the
+   # provided host tools instead.
+   foreach(_cs_tool uic rcc lrelease lconvert lupdate cs_wayland_scanner linguist)
+      string(TOUPPER ${_cs_tool} _cs_tool_uc)
+
+      if(CS_TOOL_${_cs_tool_uc} AND NOT TARGET CopperSpice::${_cs_tool})
+         add_executable(CopperSpice::${_cs_tool} IMPORTED)
+         set_target_properties(CopperSpice::${_cs_tool} PROPERTIES
+            IMPORTED_LOCATION "${CS_TOOL_${_cs_tool_uc}}")
+      endif()
+   endforeach()
+else()
+   include("${COPPERSPICE_CMAKE_DIR}/CopperSpiceBinaryTargets.cmake")
+endif()
 
 # macros required to build software which links with CopperSpice
 include("${COPPERSPICE_CMAKE_DIR}/CopperSpiceMacros.cmake")
